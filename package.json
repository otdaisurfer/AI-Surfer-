{
  "name": "ocean-tide-drop-ai-surfer",
  "version": "0.0.0",
  "type": "module",
  "description": "AI Surfer Marketing Agency - A cinematic React + Vite experience",
  "main": "index.html",
  "homepage": "https://otdaisurfer.surf",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:supabase": "node testSupabase.ts",
    "server": "tsx src/server/app.ts",
    "server:dev": "tsx watch src/server/app.ts",
    "cloudflare:whoami": "npx wrangler@4.112.0 whoami",
    "worker:dev": "npx wrangler@4.112.0 dev --remote --config wrangler.worker.jsonc",
    "worker:deploy": "npx wrangler@4.112.0 deploy --config wrangler.worker.jsonc",
    "worker:browser": "npx wrangler@4.112.0 browser create",
    "worker:retry:dev": "npx wrangler@4.112.0 dev --remote --config wrangler.wave-check-retry.jsonc",
    "worker:retry:deploy": "npx wrangler@4.112.0 deploy --config wrangler.wave-check-retry.jsonc",
    "worker:retry:check": "npx wrangler@4.112.0 deploy --dry-run --config wrangler.wave-check-retry.jsonc"
  },
  "keywords": ["react", "vite", "typescript", "marketing", "ai-surfer", "agents"],
  "author": "Shannon Foster",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@openai/agents": "latest",
    "@supabase/supabase-js": "^2.110.0",
    "autoprefixer": "^10.5.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.294.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.1",
    "vite-node": "^6.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^8.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-react-oxc": "^0.4.3",
    "eslint": "^8.0.0",
    "jsdom": "^22.0.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  },
  "engines": { "node": ">=18.0.0", "npm": ">=9.0.0" }
}
